#This script was written to look at the relationship between self-reported insomnia, 
#child and adulthood trauma variables from the Thoughts & Feelings Questionnaire (TaFQ)
#and confounding sociodemographic variables.

#The packages needed for analysis:
library(tidyverse)
library(readr)
library(dplyr)
library(ggplot2)
library(data.table)

#Reading the .tsv datafile downloaded from BioBank Research Analysis Platform (RAP)
all_insom <- read_tsv("data_insomnia.tsv", col_names = TRUE)

#renaming columns, any name can be chosen 
#You can look up the original numerical codes in the search bar of the BioBank website
all_insom <- all_insom %>% 
  rename("age" = "21022-0.0",
         "mm" = "52-0.0",
         "yyyy" = "34-0.0",
         "imde" = "26410-0.0",
         "imds" = "26427-0.0",
         "imdw" = "26426-0.0",
         "sex" = "31-0.0",
         "tdi" = "22189-0.0",
         "ethnic" = "21000-0.0",
         "sleep_i" = "1200-0.0",
         "lchild_t" = "20489-0.0",
         "pchild_t" = "20488-0.0",
         "schild_t" = "20490-0.0",
         "hchild_t" = "20487-0.0",
         "dchild_t" = "20491-0.0",
         "cradult_t" = "20522-0.0",         
         "padult_t" = "20523-0.0",
         "eadult_t" = "20521-0.0",
         "siadult_t" = "20524-0.0",
         "rmadult_t" = "20525-0.0",
        "shift" = "826-0.0",
        "bmi" = "21001-0.0",
        "diab" = "2443-0.0",
        "falco" = "20414-0.0",
        "sixalco" = "20416-0.0",
        "smoke" = "20116-0.0",
        "sed" = "40043-0.0")

#creating dataset with only those who answered Thoughts & Feelings Questionnaire
all_df_insom <- dplyr::filter(all_insom, pchild_t >= -818)
#all 'NA' will be dropped with this code
#returned 157,298 participants

#Removing all NA/missing data from the dataset
all_df_insom <- all_df_insom %>% drop_na (age,sex,tdi,ethnic,sleep_i, 
shift,bmi,diab,falco,smoke,sed)
#returned 44,245 of present dataset

#-818 indicates 'prefer not to answer' for trauma questions
#Before calculating score you need to replace -818 with 0 in order to not skew the score
all_df_insom [all_df_insom == -818] <- 0

#Reverse coding positively phrased Likert-style trauma variables
reverse_cols = c("lchild_t","dchild_t","cradult_t","rmadult_t")
all_df_insom[ ,reverse_cols] = 4 - all_df_insom[ ,reverse_cols]

#To create the trauma groups of interest you have to add the scores, 
#and then select those who have a score of >= 1

#Calculating composite childhood trauma score
all_df_insom <- all_df_insom %>% mutate (sumrowc = lchild_t + pchild_t + schild_t +
                                         hchild_t + dchild_t)
#Calculating abuse and neglect childhood trauma scores
all_df_insom <- all_df_insom %>% mutate (sumrowca = pchild_t + schild_t +
                                           hchild_t)
all_df_insom <- all_df_insom %>% mutate (sumrowcn = lchild_t + dchild_t)

#Calculating composite adult trauma score
all_df_insom <- all_df_insom %>% mutate(sumrowa = cradult_t + padult_t + eadult_t +
                                          siadult_t + rmadult_t)
#Calculating abuse and neglect adult trauma scores
all_df_insom <- all_df_insom %>% mutate (sumrowaa = padult_t + eadult_t +
                                           siadult_t)
all_df_insom <- all_df_insom %>% mutate (sumrowan = cradult_t + rmadult_t)

#For isolating control group (no trauma)
all_df_insom <- all_df_insom %>% mutate(sumrow = lchild_t + pchild_t + schild_t +
                                          hchild_t + dchild_t + cradult_t + 
                                          padult_t + eadult_t + siadult_t + 
                                          rmadult_t)
all_df_control <- dplyr::filter(all_df_insom, sumrow == 0)

#Dataset for isolating only childhood trauma group
all_df_child <- dplyr::filter(all_df_insom, sumrowc > 0)
all_df_child <- dplyr::filter(all_df_child, sumrowa == 0)
all_df_child <- dplyr::filter(all_df_child, sumrow > 0)

#Dataset for isolating only adult trauma group
all_df_adult <- dplyr::filter(all_df_insom, sumrowa > 0)
all_df_adult <- dplyr::filter(all_df_adult, sumrowc == 0)
all_df_adult <- dplyr::filter(all_df_adult, sumrow > 0)

#Thoughts and Feelings Questionnaire subscales:
#Witt et al. (2022) DOI: 10.1186/s13034-022-00506-6
#TaFQ included the 5-item Childhood Trauma Screener and bespoke matching adulthood screener
#These covered questions on neglect and abuse - these are the subscales

#Dataset for isolating childhood abuse and neglect subscales
#Abuse
all_a_child <- dplyr::filter(all_df_child, sumrowca > 0)
all_a_child <- dplyr::filter(all_a_child, sumrowcn == 0)
#Neglect
all_n_child <- dplyr::filter(all_df_child, sumrowcn > 0)
all_n_child <- dplyr::filter(all_n_child, sumrowca == 0)

#Dataset for isolating adulthood abuse and neglect subscales
#Abuse
all_a_adult<- dplyr::filter(all_df_adult, sumrowaa > 0)
all_a_adult <- dplyr::filter(all_a_adult, sumrowan == 0)
#Neglect
all_n_adult <- dplyr::filter(all_df_adult, sumrowan > 0)
all_n_adult <- dplyr::filter(all_n_adult, sumrowaa == 0)

#For isolating both childhood + adulthood trauma group 
all_df_both <- dplyr::filter(all_df_insom, sumrowc > 0)
all_df_both <- dplyr::filter(all_df_both, sumrowa > 0)

#For isolating those with BOTH child and adulthood ABUSE group
all_a_both <- dplyr::filter(all_df_insom, sumrowca > 0)
all_a_both <- dplyr::filter(all_a_both, sumrowaa > 0)
all_a_both <- dplyr::filter(all_a_both, sumrowcn == 0)
all_a_both <- dplyr::filter(all_a_both, sumrowan == 0)

#For isolating BOTH child and adulthood NEGLECT
all_n_both <- dplyr::filter(all_df_insom, sumrowcn > 0)
all_n_both <- dplyr::filter(all_n_both, sumrowan > 0)
all_n_both <- dplyr::filter(all_n_both, sumrowca == 0)
all_n_both <- dplyr::filter(all_n_both, sumrowaa == 0)

#For isolating combined groups: childhood abuse and adulthood neglect
all_caan_both <- dplyr::filter(all_df_insom, sumrowca > 0)
all_caan_both <- dplyr::filter(all_caan_both, sumrowan > 0)
all_caan_both <- dplyr::filter(all_caan_both, sumrowcn == 0)
all_caan_both <- dplyr::filter(all_caan_both, sumrowaa == 0)

#For isolating combined groups: childhood neglect and adulthood abuse
all_cnaa_both <- dplyr::filter(all_df_insom, sumrowcn > 0)
all_cnaa_both <- dplyr::filter(all_cnaa_both, sumrowaa > 0)
all_cnaa_both <- dplyr::filter(all_cnaa_both, sumrowca == 0)
all_cnaa_both <- dplyr::filter(all_cnaa_both, sumrowan == 0)

#For isolating combined groups: childhood trauma and adulthood neglect
all_ctan_both <- dplyr::filter(all_df_insom, sumrowca > 0)
all_ctan_both <- dplyr::filter(all_ctan_both, sumrowcn > 0)
all_ctan_both <- dplyr::filter(all_ctan_both, sumrowan > 0)
all_ctan_both <- dplyr::filter(all_ctan_both, sumrowaa == 0)

#For isolating combined groups: childhood trauma and adulthood abuse
all_ctaa_both <- dplyr::filter(all_df_insom, sumrowca > 0)
all_ctaa_both <- dplyr::filter(all_df_insom, sumrowcn > 0)
all_ctaa_both <- dplyr::filter(all_ctaa_both, sumrowaa > 0)
all_ctaa_both <- dplyr::filter(all_ctaa_both, sumrowan == 0)

#For isolating combined groups: childhood abuse and adulthood trauma
all_caat_both <- dplyr::filter(all_df_insom, sumrowaa > 0)
all_caat_both <- dplyr::filter(all_caat_both, sumrowan > 0)
all_caat_both <- dplyr::filter(all_caat_both, sumrowca > 0)
all_caat_both <- dplyr::filter(all_caat_both, sumrowcn == 0)

#For isolating combined groups: childhood neglect and adulthood trauma
all_cnat_both <- dplyr::filter(all_df_insom, sumrowaa > 0)
all_cnat_both <- dplyr::filter(all_cnat_both, sumrowan > 0)
all_cnat_both <- dplyr::filter(all_cnat_both, sumrowcn > 0)
all_cnat_both <- dplyr::filter(all_cnat_both, sumrowca == 0)

#Checking all datasets add up to the total dataframe:
sum(31871, 69662, 24579, 31186)
#WOO! 157,298

#After removing all 'NA' data
sum(9101,19458,6991,8695)
